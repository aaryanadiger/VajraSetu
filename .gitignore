# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.*
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# ── Vajra-Setu specific ──────────────────────────────────────────────
# Raw captured wristband images (stored locally on device, never committed)
/raw_captures/
*.jpg
*.jpeg
*.png.tmp

# SQLite database files (offline data — local only, never committed)
*.db
*.db-shm
*.db-wal

# Calibration outputs (generated from lab data — manage separately)
/calibration/generated/
/calibration/*.lab.json

# CSV compliance exports (sensitive worker data — do not commit)
/exports/
*.csv

# Editor & IDE
.vscode/settings.json
.idea/
